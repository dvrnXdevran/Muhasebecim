Options -Indexes

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
</IfModule>

<FilesMatch "^(config|config\.sample|schema|README)\.(php|sql|md)$">
    Require all denied
</FilesMatch>

